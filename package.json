{
    "name": "homebridge-nest-climate-cntrl",
    "displayName": "Nest Climate Cntrl",
    "type": "module",
    "version": "0.5.0-beta.9",
    "description": "Nest thermostat, room sensor and Heat Link controls with a live Homebridge climate dashboard",
    "author": "pponce",
    "license": "Apache-2.0",
    "homepage": "https://github.com/pponce/homebridge-nest-climate-cntrl#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pponce/homebridge-nest-climate-cntrl.git"
    },
    "bugs": {
        "url": "https://github.com/pponce/homebridge-nest-climate-cntrl/issues"
    },
    "funding": "https://github.com/sponsors/pponce",
    "keywords": [
        "apple home",
        "homekit",
        "homebridge-plugin",
        "supports-hap",
        "nest",
        "google",
        "thermostat",
        "temperature",
        "smoke",
        "sensor",
        "hotwater"
    ],
    "main": "dist/index.js",
    "engines": {
        "node": "^22 || ^24 || ^26",
        "homebridge": "^1.11.4 || ^2.4.0"
    },
    "files": [
        "LICENSE",
        "dist/**/*",
        "config.schema.json",
        "README.md",
        "CHANGELOG.md",
        "MIGRATION.md",
        "WEB_DASHBOARD.md",
        "PRERELEASE_NOTES.md",
        "homebridge-ui/**/*",
        "AUTHENTICATION.md",
        "scripts/migration-preflight.mjs"
    ],
    "scripts": {
        "clean": "node scripts/clean.js",
        "format": "prettier --write \"{src,test,scripts}/**/*.{js,mjs}\" \"!src/{HomeKitDevice,HomeKitHistory,fetchWrapper}/**\" && eslint --fix \"src/**/*.{js,mjs}\" \"test/**/*.js\" \"scripts/**/*.js\" --ignore-pattern \"src/{HomeKitDevice,HomeKitHistory,fetchWrapper}/**\"",
        "lint": "eslint \"src/**/*.{js,mjs}\" \"test/**/*.js\" \"scripts/**/*.js\" --max-warnings=20",
        "test": "node --test \"test/*.test.js\" \"src/HomeKitDevice/*.test.js\" \"src/HomeKitHistory/*.test.js\" \"src/fetchWrapper/*.test.js\"",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"**/*.test.js\" --test-reporter=spec --test-reporter=./test/coverage-reporter.js --test-reporter-destination=stdout --test-reporter-destination=stdout \"test/*.test.js\" \"src/HomeKitDevice/*.test.js\" \"src/HomeKitHistory/*.test.js\" \"src/fetchWrapper/*.test.js\"",
        "check": "npm run lint && npm run test:coverage && npm run build",
        "build": "npm run clean && node scripts/build.js",
        "prepublishOnly": "npm run check",
        "prepare": "node scripts/prepare-git-install.js && npm run build",
        "postbuild": "node scripts/verify-build.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.5",
        "@typescript-eslint/parser": "^8.71.2",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "homebridge": "^1.11.4 || ^2.4.0",
        "prettier": "^3.9.10",
        "prettier-eslint": "^17.1.2"
    },
    "dependencies": {
        "@evan/opus": "^1.0.3",
        "chalk": "^6.0.1",
        "protobufjs": "^8.8.1",
        "werift": "^0.25.1",
        "@homebridge/plugin-ui-utils": "^2.2.0",
        "bonjour-service": "^1.4.4"
    },
    "publishConfig": {
        "access": "public",
        "tag": "beta"
    },
    "contributors": [
        "n0rt0nthec4t and the Nest Accfactory contributors"
    ]
}

