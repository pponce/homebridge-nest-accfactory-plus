{
  "pluginAlias": "NestClimateCntrl",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Nest Climate Cntrl",
        "condition": "1=2"
      },
      "accounts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "Account description for configuration"
            },
            "type": {
              "type": "string",
              "default": "google",
              "enum": [
                "google",
                "nest"
              ]
            },
            "access_token": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "See https://github.com/pponce/homebridge-nest-climate-cntrl/blob/main/AUTHENTICATION.md"
            },
            "issueToken": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "See https://github.com/pponce/homebridge-nest-climate-cntrl/blob/main/AUTHENTICATION.md"
            },
            "cookie": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "See https://github.com/pponce/homebridge-nest-climate-cntrl/blob/main/AUTHENTICATION.md"
            },
            "authMethod": {
              "type": "string",
              "default": "issueTokenCookie",
              "enum": [
                "issueTokenCookie",
                "refreshToken"
              ]
            },
            "refreshToken": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "fieldTest": {
              "type": "boolean",
              "default": false
            },
            "exclude": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "name",
            "type"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "google"
                  }
                }
              },
              "then": {
                "oneOf": [
                  {
                    "properties": {
                      "authMethod": {
                        "enum": [
                          "issueTokenCookie"
                        ]
                      }
                    },
                    "required": [
                      "issueToken",
                      "cookie"
                    ],
                    "not": {
                      "required": [
                        "refreshToken"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "authMethod": {
                        "const": "refreshToken"
                      }
                    },
                    "required": [
                      "authMethod",
                      "refreshToken"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "issueToken"
                          ]
                        },
                        {
                          "required": [
                            "cookie"
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "nest"
                  }
                }
              },
              "then": {
                "required": [
                  "access_token"
                ]
              }
            }
          ]
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "debug": {
            "type": "boolean",
            "default": false
          },
          "eveHistory": {
            "type": "boolean",
            "default": true
          },
          "exclude": {
            "type": "boolean"
          },
          "supportDump": {
            "type": "boolean",
            "default": false
          },
          "useNestAPI": {
            "type": "boolean"
          },
          "useGoogleAPI": {
            "type": "boolean"
          }
        }
      },
      "devices": {
        "type": "array",
        "items": {
          "title": "Device",
          "type": "object",
          "properties": {
            "serialNumber": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "Device serial number"
            },
            "name": {
              "title": "Name",
              "type": "string",
              "placeholder": "Device description for configuration"
            },
            "eveHistory": {
              "type": "boolean"
            },
            "exclude": {
              "type": "boolean"
            },
            "external": {
              "type": "string"
            },
            "fanDuration": {
              "type": "string"
            },
            "hotwaterBoostTime": {
              "type": "string"
            },
            "hotwaterMaxTemp": {
              "type": "string"
            },
            "hotwaterMinTemp": {
              "type": "string"
            },
            "humiditySensor": {
              "type": "boolean"
            },
            "ecoSwitch": {
              "type": "boolean",
              "default": false
            },
            "fanPresetSwitches": {
              "type": "boolean",
              "default": false
            },
            "scheduleTimeZone": {
              "type": "string"
            },
            "sensorPreview": {
              "type": "object",
              "title": "Read-only room sensor preview",
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "desired": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 35,
                  "default": 21
                }
              }
            }
          }
        }
      },
      "homes": {
        "title": "Per Home configuration options",
        "type": "array",
        "items": {
          "title": "Home",
          "type": "object",
          "properties": {
            "name": {
              "title": "Home name",
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "exclude": {
              "type": "boolean"
            }
          }
        }
      },
      "webDashboard": {
        "type": "object",
        "title": "Web dashboard",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "title": "Enable standalone dashboard"
          },
          "host": {
            "type": "string",
            "default": "0.0.0.0",
            "title": "Listen address"
          },
          "port": {
            "type": "integer",
            "default": 9444,
            "minimum": 1024,
            "maximum": 65535,
            "title": "Web port"
          },
          "displayHost": {
            "type": "string",
            "title": "Browser hostname or IP"
          },
          "certificatePath": {
            "type": "string",
            "title": "TLS certificate file"
          },
          "keyPath": {
            "type": "string",
            "title": "TLS private key file"
          },
          "protocol": {
            "type": "string",
            "title": "Connection protocol",
            "enum": [
              "https",
              "http"
            ],
            "default": "https",
            "description": "HTTPS encrypts the connection. HTTP sends passwords and dashboard data unencrypted; use only on a trusted local network."
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Accounts",
      "description": "One or more accounts to connect to Google/Nest services. See plugin documentation for details on obtaining required credentials for each account type.",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "type": "array",
          "key": "accounts",
          "title": " ",
          "buttonText": "Add Account",
          "orderable": false,
          "arrayItemTitle": "{{value.name || 'Account'}}",
          "items": [
            {
              "key": "accounts[].name",
              "title": "Name"
            },
            {
              "key": "accounts[].type",
              "title": "Type",
              "enumNames": [
                "Google",
                "Nest"
              ],
              "oneOf": [
                {
                  "enum": [
                    "google"
                  ]
                },
                {
                  "enum": [
                    "nest"
                  ]
                }
              ]
            },
            {
              "key": "accounts[].authMethod",
              "title": "Authentication",
              "enumNames": [
                "Issue Token and Cookie",
                "Legacy Refresh Token"
              ],
              "condition": {
                "functionBody": "return model.accounts[arrayIndices] && model.accounts[arrayIndices].type === 'google';"
              }
            },
            {
              "key": "accounts[].issueToken",
              "title": "Issue Token",
              "condition": {
                "functionBody": "return model.accounts[arrayIndices] && model.accounts[arrayIndices].type === 'google' && (!model.accounts[arrayIndices].authMethod || model.accounts[arrayIndices].authMethod === 'issueTokenCookie');"
              }
            },
            {
              "key": "accounts[].cookie",
              "title": "Cookie",
              "condition": {
                "functionBody": "return model.accounts[arrayIndices] && model.accounts[arrayIndices].type === 'google' && (!model.accounts[arrayIndices].authMethod || model.accounts[arrayIndices].authMethod === 'issueTokenCookie');"
              }
            },
            {
              "key": "accounts[].refreshToken",
              "title": "Refresh Token",
              "type": "password",
              "condition": {
                "functionBody": "return model.accounts[arrayIndices] && model.accounts[arrayIndices].type === 'google' && model.accounts[arrayIndices].authMethod === 'refreshToken';"
              }
            },
            {
              "key": "accounts[].access_token",
              "title": "Access Token",
              "condition": {
                "functionBody": "return model.accounts[arrayIndices] && model.accounts[arrayIndices].type === 'nest';"
              }
            },
            {
              "key": "accounts[].fieldTest",
              "title": "Use Field Test API"
            },
            {
              "key": "accounts[].exclude",
              "title": "Exclude Account"
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Home Settings",
      "description": "Add and configure settings for specific Nest or Google homes.",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "array",
          "title": "Homes",
          "key": "homes",
          "description": "Each entry applies to a home. The name must match the home name in the Nest or Google Home apps.",
          "buttonText": "Add Home",
          "orderable": false,
          "items": [
            {
              "key": "homes[].name",
              "title": "Home Name",
              "placeholder": "Must match the home name in the Nest or Google Home apps"
            },
            {
              "key": "homes[].exclude",
              "title": "Exclude All Devices from Home"
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Device Settings",
      "description": "Configure global device settings or override them for specific devices.",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "options.exclude",
          "title": "Exclude All Devices"
        },
        {
          "key": "options.eveHistory",
          "title": "Enable Eve History for All Devices"
        },
        {
          "type": "array",
          "title": "Device Overrides",
          "key": "devices",
          "description": "Override settings for specific devices using their serial number. Additional advanced options are available via manual configuration.",
          "buttonText": "Add Device Override",
          "orderable": false,
          "arrayItemTitle": "{{value.name || value.serialNumber || 'Device'}}",
          "items": [
            {
              "key": "devices[].serialNumber",
              "title": "Serial Number"
            },
            {
              "key": "devices[].name",
              "title": "Name"
            },
            {
              "key": "devices[].exclude",
              "title": "Exclude Device"
            },
            {
              "key": "devices[].eveHistory",
              "title": "Enable Eve History"
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Options",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "key": "options.debug",
          "title": "Enable Verbose Logging"
        },
        {
          "key": "options.supportDump",
          "title": "Enable Support Dump Logging",
          "description": "Enable detailed device data logging for troubleshooting. Only enable when requested as it may produce large logs."
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Web dashboard",
      "expandable": true,
      "expanded": false,
      "description": "Open the climate dashboard in its own browser window. HTTPS is the default. HTTP sends passwords and dashboard data unencrypted. Create the separate web account in the custom settings page.",
      "items": [
        {
          "key": "webDashboard.enabled",
          "title": "Enable standalone dashboard"
        },
        {
          "key": "webDashboard.protocol",
          "title": "Connection protocol",
          "titleMap": {
            "https": "HTTPS · encrypted",
            "http": "HTTP · unencrypted"
          }
        },
        {
          "key": "webDashboard.port",
          "title": "Web port"
        },
        {
          "key": "webDashboard.host",
          "title": "Listen address"
        },
        {
          "key": "webDashboard.displayHost",
          "title": "Browser hostname or IP (optional)"
        },
        {
          "key": "webDashboard.certificatePath",
          "title": "TLS certificate file (optional)"
        },
        {
          "key": "webDashboard.keyPath",
          "title": "TLS private key file (optional)"
        }
      ]
    }
  ],
  "customUi": true
}
